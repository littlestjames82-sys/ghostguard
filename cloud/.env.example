# GhostGuard Cloud — example environment (M3.2)
# Copy to a real env file / your deploy's secret store and replace
# every placeholder. NEVER commit a filled-in copy. These values
# are examples only — none of them are real keys.

# Legacy key form: comma-separated workspace:key pairs.
# Keys set this way are FULL-SCOPE (ingest + read + decide +
# admin). Fine for a single-operator beta; prefer the config file
# below for anything multi-agent. Required unless the config file
# supplies keys: the server refuses to start with no keys at all.
GHOSTGUARD_CLOUD_KEYS="myworkspace:replace-with-a-long-random-key"

# Scoped keys + webhooks (see config.example.json). Optional;
# can be combined with GHOSTGUARD_CLOUD_KEYS.
# GHOSTGUARD_CLOUD_CONFIG_FILE=/path/to/ghostguard-cloud-config.json

# Listen address. Default host is 127.0.0.1 — keep it there and
# put a TLS-terminating tunnel/reverse proxy in front for a beta;
# the server itself does not do TLS.
GHOSTGUARD_CLOUD_PORT=8787
GHOSTGUARD_CLOUD_HOST=127.0.0.1

# JSONL audit store path. Back this file up — it IS the trail.
# GHOSTGUARD_CLOUD_STORE=/var/lib/ghostguard/store.jsonl

# Hardening knobs (defaults shown).
# GHOSTGUARD_CLOUD_MAX_BODY_BYTES=1048576   # per-request body cap
# GHOSTGUARD_CLOUD_MAX_BATCH=500           # records per POST
# GHOSTGUARD_CLOUD_RATE_LIMIT=600          # requests/min per key (0 = off)
# GHOSTGUARD_CLOUD_MAX_WAITERS=1000        # concurrent long-polls

# Retention: at boot, compact out entries older than this many
# days. Unset = keep forever. Setting it is a destructive,
# operator-level choice — export first (GET /v1/export).
# GHOSTGUARD_CLOUD_RETENTION_DAYS=365
